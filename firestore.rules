rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isVerified() { 
      return isSignedIn() && request.auth.token.email_verified == true; 
    }
    
    function isAdmin() { 
      return isVerified() && request.auth.token.email == 'hyiamare55@gmail.com'; 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function isValidEnquiry(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.createdAt == request.time;
    }

    function isValidDemo(data) {
      return data.title is string && data.title.size() >= 3 &&
             data.category is string &&
             data.image is string;
    }

    function isValidAIBlueprint(data) {
      return data.idea is string && data.idea.size() > 0 && data.idea.size() <= 500 &&
             data.coreFeatures is list && data.techStack is list &&
             data.createdAt == request.time;
    }

    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 5. AI Blueprints
    match /blueprints/{blueprintId} {
      allow read: if true;
      allow create: if isValidAIBlueprint(incoming());
      allow delete: if isAdmin();
    }

    // 1. Settings / CMS
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Demos Catalog
    match /demos/{demoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidDemo(incoming());
      allow update: if isAdmin() && isValidDemo(incoming());
      allow delete: if isAdmin();
    }

    // 3. Contact Enquiries
    match /enquiries/{enquiryId} {
      allow create: if isValidEnquiry(incoming());
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
    }

    // 4. Activity / System
    match /activityLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
